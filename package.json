{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:cv && next build",
    "start": "next start",
    "lint": "eslint",
    "generate:cv": "tsc scripts/generate-cv-pdf.tsx components/pdf/CvDocument.tsx lib/cv-data.ts --outDir .cv-build --module nodenext --moduleResolution nodenext --target es2022 --jsx react-jsx --esModuleInterop --skipLibCheck && node .cv-build/scripts/generate-cv-pdf.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@gsap/react": "^2.1.2",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "dompurify": "^3.1.6",
    "gsap": "^3.12.5",
    "katex": "^0.16.11",
    "marked": "^12.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
